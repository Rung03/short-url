PORT=4000

# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=shorturl
DB_SSL=false

# Production (Neon/Supabase): set DATABASE_URL instead of DB_HOST..DB_NAME, and DB_SSL=true
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
IP_SALT=change-me-to-a-random-string

# Auth: secret for signing login tokens, and the primary admin created on start
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STATS_TIMEZONE=Asia/Bangkok
